{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "octant-watch",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-20",
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/octant", "/octant/*"]
  },
  "routes": [
    {
      "pattern": "guigarmon3.online/octant",
      "zone_name": "guigarmon3.online"
    },
    {
      "pattern": "guigarmon3.online/octant/*",
      "zone_name": "guigarmon3.online"
    }
  ],
  "observability": {
    "enabled": true
  }
}
